      "source": "https://docs.python.org/3.12/library/email.html",
      "license": "PSF-2.0"
    },
    "container_reader": {
      "id": "provelume-bounded-local-email",
      "version": "1",
      "uses_python_mailbox_module": false,
      "preserves_message_bytes": true,
      "shell_or_subprocess": false
    },
    "qualified_matrix": [
      {
        "platform": "ubuntu-24.04",
        "architecture": "x86_64",
        "python": "CPython 3.12",
        "profiles": [
          "eml-file-v1",
          "maildir-cur-new-v1"
        ],
        "workflow": ".github/workflows/email-smoke.yml"
      },
      {
        "platform": "windows-server-2025",
        "architecture": "x86_64",
        "python": "CPython 3.12",
        "profiles": [
          "eml-file-v1"
        ],
        "workflow": ".github/workflows/email-smoke.yml"
      }
    ],
    "unqualified": [
      "maildir-cur-new-v1 on Windows",
      "all profiles on macOS",
      "all ARM architectures",
      "mbox",
      "PST/OST",
      "remote mailboxes and provider APIs"
    ]
  },
  "stdlib_evaluation": {
    "email": {
      "decision": "selected-behind-replaceable-parser-seam",
      "use": "MIME and header parsing after exact raw bytes have been bounded and hashed",
      "policy": "explicit versioned policy and closed Provelume limits",
      "raw_bytes_authority": false
    },
    "mailbox": {
      "decision": "not-selected-for-reading-or-delimitation",
      "reason": "Its public mailbox abstractions do not establish Provelume's exact-byte, locator, symlink and snapshot invariants across the qualified profiles.",
      "runtime_imported": false
    }
  },
  "distribution": {
    "new_python_dependencies": [],
    "new_native_components": [],
    "new_language_packs": [],
    "new_provider_payloads": [],
