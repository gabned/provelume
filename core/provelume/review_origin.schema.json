{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Retained reviewed Version origin",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "source_version_id",
    "source_document_id",
    "target_document_id",
    "previous_current_version_id",
    "original_id",
    "content_hash",
    "history_ref",
    "history_sha256",
    "principal",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^ver_[0-9a-f]{32}$"
    },
    "source_version_id": {
      "type": "string",
      "pattern": "^ver_[0-9a-f]{32}$"
    },
    "source_document_id": {
      "type": "string",
      "pattern": "^doc_[0-9a-f]{32}$"
    },
    "target_document_id": {
      "type": "string",
      "pattern": "^doc_[0-9a-f]{32}$"
    },
    "previous_current_version_id": {
      "type": "string",
      "pattern": "^ver_[0-9a-f]{32}$"
    },
    "original_id": {
      "type": "string",
      "pattern": "^sha256_[0-9a-f]{64}$"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "history_ref": {
      "type": "string",
      "pattern": "^state/review/(duplicates|versions)/review_[0-9a-f]{32}\\.json$"
    },
    "history_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "principal": {
      "enum": [
        "local_browser",
        "local_cli"
      ]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
