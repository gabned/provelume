{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provelume.com/schemas/annotation-revision-v1.schema.json",
  "title": "Retained attributed OCR/transcript annotation revision v1",
  "description": "Runtime additionally enforces exact source lineage/anchors, hashes, history CAS and authentic Original/result bindings.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "revision",
    "previous_sha256",
    "source",
    "segments",
    "action",
    "restores_revision",
    "request_id",
    "principal",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^annrev_[0-9a-f]{64}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "previous_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "const": "ABSENT"
        }
      ]
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "segments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/segment"
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "action": {
      "enum": [
        "save",
        "undo"
      ]
    },
    "restores_revision": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        {
          "type": "null"
        }
      ]
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "principal": {
      "enum": [
        "local_browser",
        "local_cli"
      ]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "anchor": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "page"
          ],
          "properties": {
            "kind": {
              "const": "page"
            },
            "page": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "page",
            "x",
            "y",
            "width",
            "height",
            "page_width",
            "page_height"
          ],
          "properties": {
            "kind": {
              "const": "region"
            },
            "page": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000000
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000000
            },
            "page_width": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000000
            },
            "page_height": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000000
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "start_ms",
            "end_ms"
          ],
          "properties": {
            "kind": {
              "const": "time"
            },
            "start_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 86400000
            },
            "end_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 86400000
            }
          }
        }
      ]
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "speaker_label",
        "confidence",
        "anchors",
        "lineage"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^aseg_[0-9a-f]{64}$"
        },
        "text": {
          "type": "string",
          "maxLength": 500000
        },
        "speaker_label": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "anchors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/anchor"
          },
          "minItems": 1,
          "maxItems": 1000
        },
        "lineage": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^aseg_[0-9a-f]{64}$"
          },
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true
        }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "original_id",
        "original_sha256",
        "original_size_bytes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ver_[0-9a-f]{32}$"
        },
        "original_id": {
          "type": "string",
          "pattern": "^sha256_[0-9a-f]{64}$"
        },
        "original_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "original_size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 536870912
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "media_type",
        "available"
      ],
      "properties": {
        "kind": {
          "enum": [
            "image",
            "pdf",
            "audio",
            "video",
            "unavailable"
          ]
        },
        "media_type": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/webp",
            "image/tiff",
            "application/pdf",
            "audio/wav",
            "audio/mpeg",
            "audio/mp4",
            "audio/ogg",
            "audio/flac",
            "video/mp4",
            "video/webm",
            null
          ]
        },
        "available": {
          "type": "boolean"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "kind",
        "version",
        "binding",
        "segments",
        "media"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^(repr_[0-9a-f]{64}|derived_[0-9a-f]{32})$"
        },
        "kind": {
          "enum": [
            "ocr",
            "audio",
            "video",
            "subtitle"
          ]
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result_sha256",
            "recipe_sha256",
            "implementation_sha256"
          ],
          "properties": {
            "result_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "recipe_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "implementation_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/segment"
          },
          "minItems": 1,
          "maxItems": 1000
        },
        "media": {
          "$ref": "#/$defs/media"
        }
      }
    }
  }
}
