{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provelume.com/schemas/representation-bundle-v1.json",
  "title": "Provelume universal representation bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_type",
    "representation_id",
    "version",
    "recipe",
    "output_fingerprint",
    "outputs",
    "implementation",
    "warnings",
    "lifecycle",
    "availability",
    "provenance",
    "corrections",
    "anchors",
    "limits",
    "invariants"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "schema_type": {"const": "provelume.representation-bundle"},
    "representation_id": {"type": "string", "pattern": "^repr_[0-9a-f]{64}$"},
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "original_id", "original_sha256", "original_size_bytes"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "original_id": {"$ref": "#/$defs/identifier"},
        "original_sha256": {"$ref": "#/$defs/sha256"},
        "original_size_bytes": {"type": "integer", "minimum": 0, "maximum": 17179869184}
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "settings", "fingerprint"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "version": {"$ref": "#/$defs/identifier"},
        "settings": {"type": "object"},
        "fingerprint": {"$ref": "#/$defs/sha256"}
      }
    },
    "output_fingerprint": {"$ref": "#/$defs/sha256"},
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "media_type", "storage_ref", "sha256", "size_bytes"],
        "properties": {
          "id": {"type": "string", "pattern": "^rout_[0-9a-f]{64}$"},
          "media_type": {"type": "string", "minLength": 3, "maxLength": 200},
          "storage_ref": {"type": "string", "minLength": 1, "maxLength": 240},
          "sha256": {"$ref": "#/$defs/sha256"},
          "size_bytes": {"type": "integer", "minimum": 0, "maximum": 17179869184}
        }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "component_version", "adapter", "adapter_version", "settings"],
      "properties": {
        "component": {"$ref": "#/$defs/identifier"},
        "component_version": {"$ref": "#/$defs/identifier"},
        "adapter": {"$ref": "#/$defs/identifier"},
        "adapter_version": {"$ref": "#/$defs/identifier"},
        "settings": {"type": "object"}
      }
    },
    "warnings": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "created_at", "removed_at"],
      "properties": {
        "state": {"enum": ["active", "degraded", "removed"]},
        "created_at": {"type": "string", "format": "date-time"},
        "removed_at": {
          "anyOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "removed"}}},
          "then": {"properties": {"removed_at": {"type": "string"}}}
        },
        {
          "if": {"properties": {"state": {"enum": ["active", "degraded"]}}},
          "then": {"properties": {"removed_at": {"const": null}}}
        }
      ]
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason", "missing_component"],
      "properties": {
        "state": {"enum": ["available", "degraded", "unavailable"]},
        "reason": {
          "type": ["string", "null"],
          "enum": [null, "component_missing", "disabled_by_configuration", "invalid_contract", "not_applicable", "not_declared", "not_implemented", "output_dependent", "profile_limited", "unsupported_platform"]
        },
        "missing_component": {
          "anyOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "available"}}},
          "then": {
            "properties": {
              "reason": {"const": null},
              "missing_component": {"const": null}
            }
          }
        },
        {
          "if": {"properties": {"state": {"enum": ["degraded", "unavailable"]}}},
          "then": {"properties": {"reason": {"type": "string"}}}
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["derived_from_version_id", "previous_representation_ids", "parent_representation_ids"],
      "properties": {
        "derived_from_version_id": {"$ref": "#/$defs/identifier"},
        "previous_representation_ids": {"$ref": "#/$defs/representationIds"},
        "parent_representation_ids": {"$ref": "#/$defs/representationIds"}
      }
    },
    "corrections": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "anchor_id", "before_sha256", "after_sha256", "reversible"],
        "properties": {
          "id": {"type": "string", "pattern": "^rcor_[0-9a-f]{64}$"},
          "kind": {"enum": ["replace", "suppress", "restore", "relabel"]},
          "anchor_id": {"type": "string", "pattern": "^ranc_[0-9a-f]{64}$"},
          "before_sha256": {"$ref": "#/$defs/sha256"},
          "after_sha256": {"$ref": "#/$defs/sha256"},
          "reversible": {"const": true}
        }
      }
    },
    "anchors": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "version_id", "representation_id", "target"],
        "properties": {
          "id": {"type": "string", "pattern": "^ranc_[0-9a-f]{64}$"},
          "kind": {"enum": ["page", "time", "region", "slide", "sheet", "cell", "member", "symbol"]},
          "version_id": {"$ref": "#/$defs/identifier"},
          "representation_id": {"type": "string", "pattern": "^repr_[0-9a-f]{64}$"},
          "target": {"type": "object", "minProperties": 1}
        },
        "allOf": [
          {
            "if": {"properties": {"kind": {"const": "page"}}},
            "then": {
              "properties": {
                "target": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["page"],
                  "properties": {"page": {"type": "integer", "minimum": 1}}
                }
              }
            }
          },
          {
            "if": {"properties": {"kind": {"const": "time"}}},
            "then": {
              "properties": {
                "target": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["start_ms", "end_ms"],
                  "properties": {
                    "start_ms": {"type": "integer", "minimum": 0},
                    "end_ms": {"type": "integer", "minimum": 0}
                  }
                }
              }
            }
          },
          {
            "if": {"properties": {"kind": {"const": "region"}}},
            "then": {
              "properties": {
                "target": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["page", "x", "y", "width", "height"],
                  "properties": {
                    "page": {"type": "integer", "minimum": 1},
                    "x": {"type": "number", "minimum": 0},
                    "y": {"type": "number", "minimum": 0},
                    "width": {"type": "number", "exclusiveMinimum": 0},
                    "height": {"type": "number", "exclusiveMinimum": 0}
                  }
                }
              }
            }
          },
          {
            "if": {"properties": {"kind": {"enum": ["slide", "sheet", "cell", "member", "symbol"]}}},
            "then": {"properties": {"target": {"const": {"reserved": true}}}}
          }
        ]
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_outputs", "max_anchors", "max_corrections", "max_warnings", "max_path_chars", "max_segment_chars", "max_file_bytes", "max_total_bytes", "max_expansion_ratio"],
      "properties": {
        "max_outputs": {"type": "integer", "minimum": 1, "maximum": 1000},
        "max_anchors": {"type": "integer", "minimum": 1, "maximum": 100000},
        "max_corrections": {"type": "integer", "minimum": 1, "maximum": 10000},
        "max_warnings": {"type": "integer", "minimum": 1, "maximum": 1000},
        "max_path_chars": {"type": "integer", "minimum": 1, "maximum": 240},
        "max_segment_chars": {"type": "integer", "minimum": 1, "maximum": 120},
        "max_file_bytes": {"type": "integer", "minimum": 1, "maximum": 17179869184},
        "max_total_bytes": {"type": "integer", "minimum": 1, "maximum": 549755813888},
        "max_expansion_ratio": {"type": "integer", "minimum": 1, "maximum": 1000}
      }
    },
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["derived", "attributable", "removable", "rebuildable", "original_immutable", "canonical_records_immutable", "provider_data_immutable", "network_used", "ai_used"],
      "properties": {
        "derived": {"const": true},
        "attributable": {"const": true},
        "removable": {"const": true},
        "rebuildable": {"const": true},
        "original_immutable": {"const": true},
        "canonical_records_immutable": {"const": true},
        "provider_data_immutable": {"const": true},
        "network_used": {"const": false},
        "ai_used": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"},
    "representationIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^repr_[0-9a-f]{64}$"}
    }
  }
}
