{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provelume.example/schemas/google-contract-v1.json",
  "title": "Provelume Google read-only adapter contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adapter_id",
    "adapter_version",
    "conformance_profile",
    "qualification",
    "real_google_qualified",
    "allowed_origins",
    "capabilities"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "adapter_id": {"const": "provelume.google"},
    "adapter_version": {"const": "1.0.0"},
    "conformance_profile": {"const": "provelume.google.readonly.v1"},
    "qualification": {"const": "local-conformance-preview"},
    "real_google_qualified": {"const": false},
    "allowed_origins": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "https://accounts.google.com",
          "https://gmail.googleapis.com",
          "https://oauth2.googleapis.com",
          "https://www.googleapis.com"
        ]
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gmail", "drive"],
      "properties": {
        "gmail": {"$ref": "#/$defs/gmailCapability"},
        "drive": {"$ref": "#/$defs/driveCapability"}
      }
    }
  },
  "$defs": {
    "credentialReference": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": {"enum": ["environment", "system_keyring"]},
            "name": {"type": "string", "minLength": 1, "maxLength": 200}
          }
        }
      ]
    },
    "capability": {
      "type": "object",
      "required": ["capability", "scope", "state", "authorization_status", "credential_reference", "consent", "revision"],
      "properties": {
        "capability": {"enum": ["gmail", "drive"]},
        "scope": {"type": "array", "minItems": 1, "maxItems": 1},
        "state": {"enum": ["disabled", "enabled"]},
        "authorization_status": {"enum": ["not_authorized", "authorized", "revoked", "reauthorization_required"]},
        "credential_reference": {"$ref": "#/$defs/credentialReference"},
        "consent": {"enum": [null, "explicit"]},
        "revision": {"type": "integer", "minimum": 1}
      }
    },
    "gmailCapability": {
      "allOf": [
        {"$ref": "#/$defs/capability"},
        {"properties": {"capability": {"const": "gmail"}, "scope": {"const": ["https://www.googleapis.com/auth/gmail.readonly"]}}}
      ]
    },
    "driveCapability": {
      "allOf": [
        {"$ref": "#/$defs/capability"},
        {"properties": {"capability": {"const": "drive"}, "scope": {"const": ["https://www.googleapis.com/auth/drive.readonly"]}}}
      ]
    }
  }
}
