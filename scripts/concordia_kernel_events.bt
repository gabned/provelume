// Model-free observer admission only. cpid is the controlled strace child.
// No paths, buffers, arguments, stacks, task names or environment are recorded.
#ifndef CAPTURE_BINDING
#define CAPTURE_BINDING 0
#endif
BEGIN { @owned[cpid] = 1; @active = 0; }

tracepoint:sched:sched_process_fork
/@owned[args.parent_pid]/
{
  @owned[args.child_pid] = 1;
  @emitted[1] = count();
  printf("F %llu %d %d\n", nsecs, args.parent_pid, args.child_pid);
}

tracepoint:sched:sched_switch
/(!CAPTURE_BINDING || @active) && (@owned[args.prev_pid] || @owned[args.next_pid])/
{
  @emitted[2] = count();
  printf("S %llu %d %d %d\n", nsecs,
    @owned[args.prev_pid] ? args.prev_pid : 0,
    @owned[args.next_pid] ? args.next_pid : 0, args.prev_state);
}

tracepoint:sched:sched_wakeup
/(!CAPTURE_BINDING || @active) && @owned[args.pid]/
{
  @emitted[3] = count();
  printf("W %llu %d\n", nsecs, args.pid);
}

tracepoint:syscalls:sys_enter_write
/(!CAPTURE_BINDING || @active) && @owned[tid] && args.fd == 198 && args.count >= 1 && args.count <= 10/
{
  @emitted[8] = count();
  printf("T %llu %d %d\n", nsecs, tid, args.count);
}

// Independent raw register arguments: x86-64 __NR_write == 1.
// No count-range predicate; exact marker identities are checked in userspace.
tracepoint:raw_syscalls:sys_enter
/@owned[tid] && args.id == 1 && args.args[0] == 198/
{
  if (CAPTURE_BINDING && args.args[2] == 9) { @active = 1; }
  @emitted[4] = count();
  printf("M %llu %d %llu\n", nsecs, tid, args.args[2]);
  if (CAPTURE_BINDING && args.args[2] == 10) { @active = 0; }
}

tracepoint:syscalls:sys_enter_futex
/(!CAPTURE_BINDING || @active) && @owned[tid]/
{
  @emitted[5] = count();
  printf("U %llu %d 1\n", nsecs, tid);
}

tracepoint:syscalls:sys_exit_futex
/(!CAPTURE_BINDING || @active) && @owned[tid]/
{
  @emitted[5] = count();
  printf("U %llu %d 0\n", nsecs, tid);
}

tracepoint:syscalls:sys_enter_fsync
/(!CAPTURE_BINDING || @active) && @owned[tid]/
{
  @emitted[6] = count();
  printf("D %llu %d 1\n", nsecs, tid);
}

tracepoint:syscalls:sys_exit_fsync
/(!CAPTURE_BINDING || @active) && @owned[tid]/
{
  @emitted[6] = count();
  printf("D %llu %d 0\n", nsecs, tid);
}

tracepoint:sched:sched_process_exit
/@owned[tid]/
{
  @emitted[7] = count();
  printf("X %llu %d\n", nsecs, tid);
  delete(@owned[tid]);
}

END { clear(@owned); clear(@active); }
